# Configuración de Entorno para Producción (VPS Hostinger)

# Puerto en el que la app web escuchará en tu VPS
PORT=5077

# Modo Depuración (0 = Desactivado para producción, 1 = Activado para desarrollo)
FLASK_DEBUG=0

# Credenciales de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=proyecciones_secret_2026
POSTGRES_DB=proyecciones

# Cadena de conexión interna de Docker (apunta al contenedor 'db')
DATABASE_URL=postgresql://postgres:proyecciones_secret_2026@db:5432/proyecciones
